
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}


model Tenant {
  id           String   @id @default(cuid())

  name         String
  slug         String  @unique
  subdomain    String  @unique
  customDomain String  @unique

  logo         String?
  email        String?
  phone        String?

  // Status — false until DNS is verified for customDomain
  verified     Boolean  @default(false)

  // Is this tenant allowed to use the platform?
  isActive     Boolean  @default(true)

  // Relations
  users        User[]
  courses      Course[]
  purchases    Purchase[]
  payments     Payment[]
  LiveMeetings LiveMeeting[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ============================================================
// AUTH — custom JWT + DB-session based 
// ============================================================

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String    @db.Text
  email         String
  emailVerified Boolean   @default(false)
  role          Role      @default(STUDENT)
  image         String?   @db.Text

  // null for users who ONLY ever signed up via Google/GitHub
  password      String?   @db.Text

  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  sessions      Session[]
  oauthAccounts OAuthAccount[]

  createdCourses       Course[]
  purchases            Purchase[]
  payments             Payment[]
  courseProgresses     CourseProgress[]
  videoProgresses      VideoProgress[]
  chatMessages         ChatMessage[]
  savedVideos          SavedVideo[]
  LiveMeetings         LiveMeeting[]
  studentQuizResponses StudentQuizResponse[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // 👇 IMPORTANT: email is unique PER TENANT, not globally.
  // The same email can exist as a user on two different tenants.
  @@unique([tenantId, email])
  @@map("user")
}

// One row = one active login (one browser / one device).
// v1: minimal fields. v2: add ipAddress, userAgent, deviceLabel, lastUsedAt etc.
// without breaking anything that already exists.
model Session {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // we NEVER store the raw refresh token, only its sha256 hash
  refreshTokenHash String   @unique

  revoked          Boolean  @default(false)
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  @@index([userId])
  @@map("session")
}

// Links a User to a Google/GitHub identity.
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider          String   // "google" | "github"
  providerAccountId String   // the "sub" (Google) or "id" (GitHub) from the provider

  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_account")
}

// Short-lived, single-use code used to hand off tokens from the
// OAuth callback (on api.motionkart.online.com) to the tenant's
// frontend (e.g. motionkart.online.com) safely.
model OAuthHandoff {
  id           String   @id @default(cuid())
  code         String   @unique
  accessToken  String   @db.Text
  refreshToken String   @db.Text
  expiresAt    DateTime // very short TTL, e.g. now + 60s
  used         Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@map("oauth_handoff")
}



model Course {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  thumbnail   String?
  price       Float    @db.Float
  oldPrice    Float    @db.Float

  rating    Float?  @db.Float
  students  Int?    @db.Int
  lessons   Int?    @db.Int
  duration  Int?    @db.Int
  category  String  @db.Text

  isPublished Boolean  @default(true)

  teacherId   String
  teacher     User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  tenantId      String
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  modules     Module[]
  chatMessages ChatMessage[]


  purchases   Purchase[]
  payments    Payment[]

  progresses    CourseProgress[]
  videoProgress VideoProgress[]
  savedVideos SavedVideo[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([teacherId])
  @@map("courses")
}



model Module {
  id         String   @id @default(cuid())
  title      String
  position   Int

  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  videos     Video[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // no duplicate module order in same course
  @@unique([courseId, position])

  @@index([courseId])
  @@map("modules")
}

enum DocumentStatus {
  pending
  ready
  failed
}

model Video {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text

  muxAssetId     String? @unique
  muxPlaybackId  String?
  muxUploadId    String?

  videoUrl    String?
  notesUrl    String? 

  aiProcessingStatus DocumentStatus   @default(pending)

  duration    Int?     // seconds
  position    Int

  isPreview   Boolean  @default(false) 


  moduleId    String
  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

    // AI Generated Content
  quiz        Json?
  assignment  Json?

  videoProgress VideoProgress[]
  chatMessages ChatMessage[]
  savedVideos SavedVideo[]

  studentQuizResponses StudentQuizResponse[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // no duplicate video order in same module
   @@unique([moduleId, position])

  @@index([moduleId])
  @@map("videos")
}

model StudentQuizResponse {

  id String @id @default(cuid())

  studentId String
  videoId String

  answers Json

  score Int

  totalQuestions Int

  submittedAt DateTime @default(now())

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([studentId, videoId])

  @@index([studentId])
  @@index([videoId])

  @@map("student_quiz_responses")
}

model Purchase {
  id          String   @id @default(cuid())

  paid        Boolean  @default(true)

  userId      String
  courseId    String

  tenantId      String
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)


  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)

  purchasedAt DateTime @default(now())

  // one user can buy one course only once
  @@unique([userId, courseId])
  @@index([userId]) 
  @@index([courseId])
  @@map("purchases")
}

model ChatMessage {
  id          String   @id @default(cuid())

  userId      String
  user        User @relation(fields: [userId], references: [id])

  courseId    String?
  course      Course? @relation(fields: [courseId], references: [id])

  videoId     String
  video       Video @relation(fields: [videoId], references: [id])

  content     Json

  createdAt   DateTime @default(now())

  @@unique([userId, videoId])
  @@index([userId])
  @@index([videoId])
}

model SavedVideo {
  id       String @id @default(cuid())

  userId   String
  videoId  String
  courseId String

  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  video    Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  savedAt  DateTime @default(now())

  // user can save a video only once
  @@unique([userId, videoId])
  @@index([userId])
  @@map("saved_videos")
}


enum PaymentProvider {
  RAZORPAY
  STRIPE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Payment {
   id                String           @id @default(cuid())

  // payment business data
  amount            Float            @db.Float
  currency          String           @default("INR")

  // provider
  provider          PaymentProvider

  receipt           String?          @unique

  // provider references
  orderId           String           @unique
  paymentId         String?          @unique
  transactionId     String?          @unique

  // webhook safety
  webhookEventId    String?          @unique
  event             String?

  // status
  status            PaymentStatus    @default(PENDING)

  // failure tracking
  failureReason     String?

  // relations
  userId            String
  courseId          String
  tenantId          String
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)


  user              User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  course            Course           @relation(fields: [courseId], references: [id], onDelete: Restrict)

  // timestamps
  paidAt            DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([userId])
  @@index([courseId])
  @@index([status])

  @@map("payments")
}

model CourseProgress {
  id              String   @id @default(cuid())

  userId          String
  courseId        String

  completedVideos Int      @default(0)
  totalVideos     Int

  progressPercent Float    @default(0)

  lastVideoId     String?

  startedAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  completedAt     DateTime?

  user            User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])

  @@map("course_progress")
}

model VideoProgress {
  id            String   @id @default(cuid())

  userId        String
  courseId      String
  videoId       String

  isCompleted   Boolean  @default(false)

  watchedSeconds Int     @default(0)

  lastPosition   Int     @default(0)

  completedAt    DateTime?
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  video          Video    @relation(fields: [videoId], references: [id], onDelete: Restrict)

  @@unique([userId, videoId])
  @@index([userId])
  @@index([courseId])
  @@index([videoId])

  @@map("video_progress")
}

enum LiveMeetingStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

model LiveMeeting {
  id          String            @id @default(cuid())

  title       String
  description String?

  roomId      String?           @unique

  teacherId   String
  teacher     User              @relation(fields: [teacherId], references: [id])

  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id])

  status      LiveMeetingStatus @default(SCHEDULED)

  scheduledAt DateTime?
  startedAt   DateTime?
  endedAt     DateTime?

  isRecorded  Boolean           @default(false)
  recordingUrl String?

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([teacherId])
  @@index([tenantId])
  @@index([status])
  @@index([scheduledAt])
}